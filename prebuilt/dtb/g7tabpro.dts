		odm: odm {
			compatible = "simple-bus";
			phandle = <0x196>;

			rt5133_eint: rt5133_eint {
				phandle = <0x197>;
			};

			rt5133_gpio1: rt5133-gpio1 {
				compatible = "regulator-fixed";
				regulator-name = "rt5133-gpio1";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				vin-supply = <0x65>;
				enable-active-high;
				gpio = <0xb9 0x00 0x00>;
				phandle = <0x198>;
			};

			rt5133_gpio2: rt5133-gpio2 {
				compatible = "regulator-fixed";
				regulator-name = "rt5133-gpio2";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				vin-supply = <0x65>;
				enable-active-high;
				gpio = <0xb9 0x01 0x00>;
				phandle = <0x199>;
			};

			rt5133_gpio3: rt5133-gpio3 {
				compatible = "regulator-fixed";
				regulator-name = "rt5133-gpio3";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				vin-supply = <0x65>;
				enable-active-high;
				gpio = <0xb9 0x02 0x00>;
				phandle = <0x19a>;
			};
		};

		extcon_usb: extcon_usb {
			compatible = "mediatek,extcon-usb";
			vbus-supply = <0xba>;
			vbus-voltage = <0x4c4b40>;
			vbus-current = <0x1b7740>;
			charger = <0x53>;
			tcpc = "type_c_port0";
			mediatek,bypss-typec-sink = <0x01>;
			mediatek,u2;
			phandle = <0x19b>;

			port {

				usb_role: endpoint@0 {
					remote-endpoint = <0xbb>;
					phandle = <0xbe>;
				};
			};
		};

		usb: usb0@11200000 {
			compatible = "mediatek,mt6789-usb20";
			reg = <0x00 0x11200000 0x00 0x10000 0x00 0x11f40000 0x00 0x10000>;
			interrupts = <0x00 0x80 0x04 0x00>;
			clocks = <0x2b 0x22 0x2a 0x1d 0x3b 0x0d>;
			clock-names = "sys_clk", "ref_clk", "src_clk";
			phys = <0x63 0x03>;
			mode = <0x02>;
			multipoint = <0x01>;
			num_eps = <0x10>;
			interrupt-names = "mc";
			dr_mode = "otg";
			usb-role-switch;
			cdp-block;
			wakeup-source;
			pericfg = <0xbc>;
			infracg = <0xbd>;
			phandle = <0x64>;

			port {

				musb_drd_switch: endpoint@0 {
					remote-endpoint = <0xbe>;
					phandle = <0xbb>;
				};
			};
		};

		u2phy0: usb-phy@11f40000 {
			compatible = "mediatek,generic-tphy-v2";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			status = "okay";
			phandle = <0x19c>;

			u2port0: usb-phy@11f40000 {
				reg = <0x00 0x11f40000 0x00 0x700>;
				clocks = <0x55>;
				clock-names = "ref";
				#phy-cells = <0x01>;
				mediatek,eye-vrt = <0x04>;
				mediatek,eye-term = <0x04>;
				mediatek,rev4 = <0x01>;
				mediatek,rx_sqth = <0x05>;
				mediatek,discth = <0x07>;
				nvmem-cells = <0xbf>;
				nvmem-cell-names = "intr_cal";
				nvmem-cell-masks = <0x1f>;
				status = "okay";
				phandle = <0x63>;
			};
		};

		u3fpgaphy: usb-phy {
			compatible = "mediatek,fpga-u3phy";
			mediatek,ippc = <0x11f40000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			fpga_i2c_physical_base = <0x11eb0000>;
			status = "disabled";
			phandle = <0x19d>;

			u3fpgaport0: usb-phy@0 {
				chip-id = <0xa60931a>;
				port = <0x00>;
				pclk_phase = <0x17>;
				#phy-cells = <0x01>;
				phandle = <0x19e>;
			};
		};

		usb_boost: usb_boost_manager {
			compatible = "mediatek,usb_boost", "mediatek,mt6789-usb_boost";
