		};

		usb_meta: usb_meta {
			compatible = "mediatek,usb_meta";
			udc = <0x64>;
			phandle = <0x1a0>;
		};

		drm_wv: drm_wv {
			compatible = "mediatek,drm_wv";
			status = "okay";
