	mtk_lpm: mtk_lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		lpm-kernel-suspend = <0x00>;
		suspend-method = "enable";
		logger-enable-states = "mcusysoff", "system_mem", "system_pll", "system_bus";
		irq-remain = <0xc0 0xc1 0xc2 0xc3 0xc4>;
		resource-ctrl = <0xc5 0xc6 0xc7 0xc8 0xc9>;
		constraints = <0xca 0xcb 0xcc 0xcd>;
		spm-cond = <0xce 0xcf>;
		cg-shift = <0x00>;
		pll-shift = <0x10>;
		power-gs = <0x00>;
		mcusys-cnt-chk = <0x01>;
		phandle = <0x1a4>;

		cpupm_sysram: cpupm-sysram@0011b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
			phandle = <0x1a5>;
		};

		mcusys_ctrl: mcusys-ctrl@0c53a000 {
			compatible = "mediatek,mcusys-ctrl";
			reg = <0x00 0xc53a000 0x00 0x1000>;
			phandle = <0x1a6>;
		};

		lpm_sysram: lpm_sysram@0011b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
			phandle = <0x1a7>;
		};

		irq-remain-list {

			edge_keypad: edge_keypad {
				target = <0xd0>;
				value = <0x01 0x00 0x00 0x04>;
				phandle = <0xc0>;
			};

			edge_mdwdt: edge_mdwdt {
				target = <0xd1>;
				value = <0x01 0x00 0x80000000 0x2000000>;
				phandle = <0xc1>;
			};

			level_btif_tx: level_btif_tx {
				target = <0xd2>;
				value = <0x00 0x01 0x00 0x00>;
				phandle = <0xc2>;
			};

			level_btif_rx: level_btif_rx {
				target = <0xd2>;
				value = <0x00 0x02 0x00 0x00>;
				phandle = <0xc3>;
			};

			level_usb: level_usb {
				target = <0x64>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0xc4>;
			};
		};

		resource-ctrl-list {

			bus26m: bus26m {
				id = <0x00>;
				value = <0x00>;
				phandle = <0xc5>;
			};

			infra: infra {
				id = <0x01>;
				value = <0x00>;
				phandle = <0xc6>;
			};

			syspll: syspll {
				id = <0x02>;
				value = <0x00>;
				phandle = <0xc7>;
			};

			dram_s0: dram_s0 {
				id = <0x03>;
				value = <0x00>;
				phandle = <0xc8>;
			};

			dram_s1: dram_s1 {
				id = <0x04>;
				value = <0x00>;
				phandle = <0xc9>;
			};
		};

		constraint-list {

			rc_bus26m: rc_bus26m {
				rc-name = "bus26m";
				id = <0x00>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0xca>;
			};

			rc_syspll: rc_syspll {
				rc-name = "syspll";
				id = <0x01>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0xcb>;
			};

			rc_dram: rc_dram {
				rc-name = "dram";
				id = <0x02>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0xcc>;
			};

			rc_cpu_buck_ldo: rc_cpu_buck_ldo {
				rc-name = "cpu-buck-ldo";
				id = <0x03>;
				value = <0x01>;
				cond-info = <0x00>;
				phandle = <0xcd>;
			};
		};

		spm-cond-list {

			spm_cond_cg: spm_cond_cg {
				cg-name = "MTCMOS_0", "INFRA_0", "INFRA_1", "INFRA_2", "INFRA_3", "INFRA_4", "MMSYS_0", "MMSYS_3";
				phandle = <0xce>;
			};

			spm_cond_pll: spm_cond_pll {
				pll-name = "UNIVPLL", "MFGPLL", "MSDCPLL", "TVPLL", "MMPLL";
				phandle = <0xcf>;
			};
		};

		power-gs-list {
		};
	};

