&{/soc/i2c@11e00000} {
	clock-frequency = <0x61a80>;
	status = "okay";

	chipone_touch@48 {
		compatible = "chipone_tddi";
		reg = <0x48>;
		bootmode = <0x50>;
		interrupt-parent = <0x49>;
		chipone,irq-gpio = <0x49 0x09 0x00>;
		chipone,rst-gpio = <0x49 0x98 0x00>;
		chipone,x-res = <0x4b0>;
		chipone,y-res = <0x780>;
		status = "okay";
	};
};

&{/soc/pinctrl} {
	ctp_pins_default: eintdefault {
	};

	ctp_ts_int_active: int_active {
		pins_cmd_dat {
			pinmux = <0x900>;
			input-enable;
		};
	};

	ctp_ts_int_suspend: int_suspend {
		pins_cmd_dat {
			pinmux = <0x900>;
			output-low;
		};
	};

	ctp_ts_scl_active: scl_active {
		pins_cmd_dat {
			pinmux = <0x8201>;
		};
	};

	ctp_ts_scl_suspend: scl_suspend {
		pins_cmd_dat {
			pinmux = <0x8200>;
			output-low;
		};
	};

	ctp_ts_sda_active: sda_active {
		pins_cmd_dat {
			pinmux = <0x8301>;
		};
	};

	ctp_ts_sda_suspend: sda_suspend {
		pins_cmd_dat {
			pinmux = <0x8300>;
			output-low;
		};
	};
};

&{/soc/i2c@11e00000} {
	pinctrl-names = "default", "ts_int_active", "ts_int_suspend", "ts_scl_active", "ts_scl_suspend", "ts_sda_active", "ts_sda_suspend";
	pinctrl-0 = <&ctp_pins_default>;
	pinctrl-1 = <&ctp_ts_int_active>;
	pinctrl-2 = <&ctp_ts_int_suspend>;
	pinctrl-3 = <&ctp_ts_scl_active>;
	pinctrl-4 = <&ctp_ts_scl_suspend>;
	pinctrl-5 = <&ctp_ts_sda_active>;
	pinctrl-6 = <&ctp_ts_sda_suspend>;
};

&{/chosen} {
	/* struct tag_bootmode { u32 size; u32 tag; u32 bootmode; u32 boottype; }
	 * bootmode = 0 (NORMAL_BOOT). The chipone touch driver's boot_mode_check()
	 * follows the node's "bootmode" phandle to /chosen and reads this property;
	 * without it the driver logs "failed to get atag,boot" and never registers,
	 * which is why the module loads but never probes. */
	atag,boot = <0x00 0x00 0x00 0x00>;
};

&{/chosen} {
	/* Exact bytes as present in normal boot (read from a booted system):
	 *   10 00 00 00  02 08 00 41  00 00 00 00  02 00 00 00
	 * = size 0x10, tag 0x41000802, bootmode 0 (NORMAL_BOOT), boottype 2.
	 * The chipone touch driver's boot_mode_check() follows the node's
	 * "bootmode" phandle here and reads atag,boot; without it the driver
	 * never registers, so it loads but never probes. */
	atag,boot = <0x10000000 0x02080041 0x00000000 0x02000000>;
};
